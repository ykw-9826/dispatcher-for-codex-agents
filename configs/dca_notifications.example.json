{
  "version": 1,
  "permission_notification_policy": "OFF",
  "ledger_directory": "/absolute/path/to/checkout/runtime/state/notifications",
  "sinks": [
    {
      "sink_id": "turbo_wechat",
      "kind": "serverchan",
      "enabled": false,
      "send_key_env_file": "/absolute/external/private/turbo.env"
    },
    {
      "sink_id": "sc3_app",
      "kind": "serverchan",
      "enabled": false,
      "send_key_env_file": "/absolute/external/private/sc3.env"
    },
    {
      "sink_id": "dingtalk_group",
      "kind": "dingtalk",
      "enabled": false,
      "webhook_env_file": "/absolute/external/private/dingtalk-webhook.env",
      "signing": "HMAC_SHA256",
      "signing_secret_env_file": "/absolute/external/private/dingtalk-signing.env"
    }
  ]
}
